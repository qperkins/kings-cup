# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore vitest AI agent docs
vitestDocs.md

# Ignore docs folder (local agent docs)
/docs/

.venv/
__pycache__/

